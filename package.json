{
  "name": "job-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"vite --host 0.0.0.0\" \"wrangler dev --local --ip 0.0.0.0 --port 8787 --persist-to .wrangler/state\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --local --ip 0.0.0.0 --port 8787 --persist-to .wrangler/state",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:flow": "node scripts/flow-smoke.mjs",
    "smoke:upload": "node scripts/upload-smoke.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "db:migrate:local": "wrangler d1 migrations apply job-board-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply job-board-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "better-sqlite3": "^13.1.1",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
